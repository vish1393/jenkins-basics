pipeline {
    agent any

    // Automatically installs and binds the Maven binary path
    tools {
        maven 'Maven 3.9' // Must match the Name configured in Jenkins Tools
    }

    environment {
        // Populates NEXUS_CREDS_USR and NEXUS_CREDS_PSW securely in the shell env
        NEXUS_CREDS = credentials('nexus-credentials-id')
    }

    stages {
        stage('Checkout & Environment') {
            steps {
                echo 'Pipeline connected to Git repository successfully!'
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build & Deploy to Nexus') {
            steps {
                echo 'Generating Maven settings and deploying to Nexus...'
                sh '''
                    cat <<EOF > settings.xml
<settings>
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>${NEXUS_CREDS_USR}</username>
      <password>${NEXUS_CREDS_PSW}</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>${NEXUS_CREDS_USR}</username>
      <password>${NEXUS_CREDS_PSW}</password>
    </server>
  </servers>
</settings>
EOF

                    mvn clean deploy -U -s settings.xml -DskipTests
                    rm -f settings.xml
                '''
            }
        }
    }

    post {
        success {
            echo 'Artifact successfully stored in local Nexus!'
            
            // Displays workspace path and lists generated JAR files inside target/
            sh '''
                echo "=================================================="
                echo "Jenkins Workspace Directory : ${WORKSPACE}"
                echo "Built Artifact Path(s)      :"
                find target/ -maxdepth 1 -name "*.jar" -exec readlink -f {} \\;
                echo "=================================================="
            '''
        }
        failure {
            echo 'Pipeline failed. Check build logs above.'
        }
    }
}