pipeline {
    agent any

    environment {
        // References the credential ID created in Jenkins Credentials Manager
        NEXUS_CREDS = credentials('nexus-credentials-id')
    }

    stages {
        stage('Checkout & Environment') {
            steps {
                echo 'Pipeline connected to Git repository successfully!'
                sh 'java -version'
            }
        }

        stage('Build & Deploy to Nexus') {
            steps {
                echo 'Building JAR and deploying to Nexus repository...'
                
                // Runs Maven deploy using credentials from Jenkins store
                sh """
                    mvn clean deploy \
                    -DskipTests \
                    -Dnexus.username=${NEXUS_CREDS_USR} \
                    -Dnexus.password=${NEXUS_CREDS_PSW}
                """
            }
        }
    }

    post {
        success {
            echo 'Artifact successfully stored in local Nexus!'
        }
        failure {
            echo 'Pipeline failed. Check build logs above.'
        }
    }
}