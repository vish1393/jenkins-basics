pipeline {
    agent any

    // Automatically installs and binds the Maven binary path
    tools {
        maven 'Maven 3.9' // Must match the Name configured in Jenkins Tools
    }

    environment {
        // Populates NEXUS_CREDS_USR and NEXUS_CREDS_PSW securely in the shell env
        NEXUS_CREDS = credentials('nexus-credentials-id')
    }

    stages {
        stage('Checkout & Environment') {
            steps {
                echo 'Pipeline connected to Git repository successfully!'
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build & Deploy to Nexus') {
            steps {
                echo 'Building JAR and deploying to Nexus repository...'
                
                // Use single quotes (''') to pass env vars securely without Groovy interpolation warnings
                sh '''
                    mvn clean deploy \
                    -DskipTests \
                    -Dnexus.username=${NEXUS_CREDS_USR} \
                    -Dnexus.password=${NEXUS_CREDS_PSW}
                '''
            }
        }
    }

    post {
        success {
            echo 'Artifact successfully stored in local Nexus!'
        }
        failure {
            echo 'Pipeline failed. Check build logs above.'
        }
    }
}