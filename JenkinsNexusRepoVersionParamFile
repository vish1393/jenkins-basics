stage('Bump Next Patch SNAPSHOT') {
    when {
        branch 'master'
    }
    steps {
        script {
            sh '''
                mvn build-helper:parse-version versions:set \
                  -DnewVersion=\${parsedVersion.majorVersion}.\${parsedVersion.minorVersion}.\${parsedVersion.nextPatchVersion}-SNAPSHOT \
                  -DgenerateBackupPoms=false
            '''

            def nextVersion = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()

            sh """
                git config user.name "Jenkins CI"
                git config user.email "ci@example.com"
                git commit -am "chore: bump version to ${nextVersion} [skip ci]"
            """

            withCredentials([usernamePassword(credentialsId: 'github-credentials-id', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PAT')]) {
                sh """
                    git push https://${GIT_PAT}@github.com/vish1393/jenkins-basics.git HEAD:master
                """
            }
        }
    }
}