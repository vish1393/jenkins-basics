pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
    }

    environment {
        NEXUS_CREDS = credentials('nexus-credentials-id')
        GIT_CREDS   = credentials('github-credentials-id')
    }

    stages {
        stage('Checkout & Versioning') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME ?: 'master'
                    
                    if (branchName == 'master' || branchName == 'main') {
                        // 1. Read base version from pom.xml (e.g., 1.0.0-SNAPSHOT -> 1.0)
                        def rawVersion = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()
                        def baseVersion = rawVersion.replace('-SNAPSHOT', '')
                        
                        // Extract Major.Minor (e.g., "1.0.0" -> "1.0")
                        def parts = baseVersion.tokenize('.')
                        def majorMinor = (parts.size() >= 2) ? "${parts[0]}.${parts[1]}" : baseVersion
                        
                        // 2. Generate a guaranteed unique release version using Jenkins BUILD_NUMBER
                        // Result format: 1.0.<BUILD_NUMBER> (e.g., 1.0.8, 1.0.9, 1.0.10)
                        def releaseVersion = "${majorMinor}.${BUILD_NUMBER}"
                        
                        echo "Setting unique RELEASE Version for master: ${releaseVersion}"
                        sh "mvn versions:set -DnewVersion=${releaseVersion} -DgenerateBackupPoms=false"
                    } else {
                        // Dynamic feature branch versioning
                        def safeBranch = branchName.replaceAll(/[^a-zA-Z0-9.-]/, '-')
                        def snapshotVersion = "1.0.${BUILD_NUMBER}-${safeBranch}-SNAPSHOT"
                        
                        echo "Setting Dynamic SNAPSHOT Version: ${snapshotVersion}"
                        sh "mvn versions:set -DnewVersion=${snapshotVersion} -DgenerateBackupPoms=false"
                    }
                }
            }
        }

        stage('Build & Deploy to Nexus') {
            steps {
                sh '''
                    cat <<EOF > settings.xml
<settings>
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>${NEXUS_CREDS_USR}</username>
      <password>${NEXUS_CREDS_PSW}</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>${NEXUS_CREDS_USR}</username>
      <password>${NEXUS_CREDS_PSW}</password>
    </server>
  </servers>
</settings>
EOF

                    mvn clean deploy -U -s settings.xml -DskipTests
                '''
            }
            post {
                always {
                    sh 'rm -f settings.xml'
                }
            }
        }

        stage('Git Tag Release') {
            when {
                branch 'master'
            }
            steps {
                script {
                    def releaseVersion = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()
                    
                    sh """
                        git config user.name "Jenkins CI"
                        git config user.email "ci@example.com"
                        git tag -a v${releaseVersion} -m "Automated Release v${releaseVersion}"
                    """
                    
                    withCredentials([usernamePassword(credentialsId: 'github-credentials-id', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PAT')]) {
                        sh """
                            git push https://${GIT_PAT}@github.com/vish1393/jenkins-basics.git v${releaseVersion}
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully!'
            sh '''
                echo "=================================================="
                echo "Jenkins Workspace Directory : ${WORKSPACE}"
                echo "Built Artifact Path(s)      :"
                find target/ -maxdepth 1 -name "*.jar" -exec readlink -f {} \\;
                echo "=================================================="
            '''
        }
        failure {
            echo 'Pipeline failed. Check build logs above.'
        }
    }
}